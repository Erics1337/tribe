EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# Set these for real AT Protocol OAuth. Leave them blank to keep the native AT button disabled.
# For a free Cloudflare Pages host like `tribepreview.pages.dev`, generate the exact values with:
# pnpm atproto:prepare-pages -- --host tribepreview.pages.dev
EXPO_PUBLIC_ATPROTO_CLIENT_ID=
EXPO_PUBLIC_ATPROTO_CLIENT_URI=
EXPO_PUBLIC_ATPROTO_REDIRECT_URI=
EXPO_PUBLIC_ATPROTO_HANDLE_RESOLVER=https://bsky.social
EXPO_PUBLIC_ATPROTO_SCOPE="atproto repo:* rpc:*?aud=did:web:api.bsky.app#bsky_appview"
EXPO_PUBLIC_ATPROTO_SIGN_IN_INPUT=https://bsky.social
