{
  "name": "@tribe/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "\"${npm_node_execpath:-node}\" ../../scripts/check-node.mjs && expo start --clear",
    "android": "\"${npm_node_execpath:-node}\" ../../scripts/check-node.mjs && expo run:android",
    "ios": "\"${npm_node_execpath:-node}\" ../../scripts/check-node.mjs && expo run:ios",
    "build": "\"${npm_node_execpath:-node}\" ../../scripts/check-node.mjs && expo export --platform ios --platform android",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atproto/api": "^0.19.3",
    "@atproto/oauth-client-expo": "^0.0.10",
    "@expo/metro-runtime": "^55.0.6",
    "@tanstack/react-query": "^5.90.5",
    "@tribe/shared": "workspace:*",
    "expo": "^55.0.6",
    "expo-constants": "^55.0.7",
    "expo-dev-client": "~55.0.16",
    "expo-image-picker": "^55.0.12",
    "expo-linking": "^55.0.7",
    "expo-router": "^55.0.5",
    "expo-secure-store": "^55.0.8",
    "expo-status-bar": "^55.0.4",
    "react": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-native": "^0.83.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.13"
  }
}
